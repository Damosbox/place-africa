# Copier en .env.local et renseigner. .env*.local est ignoré par git.

# ── Chatbot ────────────────────────────────────────────────────────────────
# URL du moteur de conversation interrogé par /api/chat.
# Contrat attendu :
#   POST <CHAT_API_URL>
#   body { "sessionId": "<uuid>", "message": "<texte du visiteur>" }
#   → 200 { "reply": "<réponse>" }
#   Les clés "message", "text", "answer" et "response" sont aussi acceptées.
#
# Tant que cette variable est absente, le widget affiche un message de repli
# renvoyant vers WhatsApp — il ne simule jamais de réponse.
CHAT_API_URL=

# Optionnelle. Envoyée au moteur en en-tête `Authorization: Bearer …`.
# Ne jamais préfixer par NEXT_PUBLIC_ : cette clé doit rester côté serveur.
CHAT_API_KEY=

# ── Formulaire de contact (SMTP) ───────────────────────────────────────────
# Sans SMTP_HOST, les demandes sont seulement journalisées en console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=info@place.africa
